{
  "name": "todo-api",
  "type": "service",
  "version": "0.1.0",
  "language": "Ballerina",
  "buildpack": "docker",
  "appPath": "todo-api",
  "entrypoint": "deployment/service",
  "exposure": "intranet",
  "stories": [
    2,
    3,
    4,
    5
  ],
  "description": "Backend service owning the todo entity: create, list, and complete/reopen a todo, scoped strictly to the signed-in caller (resolved from the gateway assertion, never a client-supplied id). Persists entries in todo-db. Does not support editing a todo's title or deleting a todo, and sends no notifications.",
  "dependencies": [
    {
      "kind": "platform-resource",
      "name": "todo-db",
      "description": "Stores each user's todo entries.",
      "resourceType": "postgres-cnpg",
      "wiring": {
        "ref": "todo-webapp-authe-8602ccce",
        "envBindings": {
          "dbname": "TODO_DB_DBNAME",
          "host": "TODO_DB_HOST",
          "password": "TODO_DB_PASSWORD",
          "port": "TODO_DB_PORT",
          "user": "TODO_DB_USER"
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "description": "Verifies the gateway's signed assertion for every request and resolves the caller's identity.",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "todo-webapp-authe-ec06c103",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "exposesAPI": {
    "auth": "end-user-required"
  },
  "skillsPinned": [
    "openapi-conventions",
    "ballerina",
    "thunder-authentication",
    "api-management"
  ]
}
